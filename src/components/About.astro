---
import { siteConfig } from "../config";

// Extract key highlights from the about text
const highlights = [
  { icon: "⚡", text: "5+ Years Experience", subtext: "More than 3 years in Germany" },
  { icon: "🏆", text: "2 Hackathon Awards", subtext: "Including 2nd Place in 2025" }
];

const story = [
  {
    text: "I'm a Software Engineer with 5+ years of professional experience, focused on Java backend development and DevOps. I work mainly with Java, Spring Boot, microservices, Docker, Kubernetes, CI/CD, Linux, and distributed systems.",
    emphasis: ["Software Engineer", "5+ years of professional experience", "Java backend development", "DevOps", "Java", "Spring Boot", "microservices", "Docker", "Kubernetes", "CI/CD", "Linux", "distributed systems"]
  },
  {
    text: "My experience spans enterprise software and production systems, with additional work in automotive software and simulation. I also served as Project Manager on a Porsche Informatik capstone collaboration. My main interests are backend engineering, DevOps, distributed systems, and reliable production software.",
    emphasis: ["enterprise software", "production systems", "automotive software", "simulation", "Project Manager", "Porsche Informatik capstone collaboration", "backend engineering", "DevOps", "distributed systems", "reliable production software"]
  }
];
---

<section id="about" class="p-8 sm:p-12 md:p-16 lg:p-24 bg-white relative overflow-hidden">
  <!-- Background decoration -->
  <div class="absolute inset-0 opacity-5">
    <div class="absolute top-20 left-10 w-32 h-32 bg-blue-500 rounded-full blur-3xl"></div>
    <div class="absolute bottom-20 right-10 w-24 h-24 bg-purple-500 rounded-full blur-3xl"></div>
  </div>
  
  <div class="relative">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
      <div class="lg:col-span-4">
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900">
          About Me
        </h2>
        <div
          class="w-[75px] h-[5px] mt-2 rounded-full bg-blue-500/30"
          style={`background-color: ${siteConfig.accentColor}`}
        />
        
        <!-- Professional highlights cards -->
        <div class="mt-8 space-y-4">
          {highlights.map((highlight) => (
            <div class="flex items-center gap-4 p-4 bg-white rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-all duration-300 group hover:-translate-y-1">
              <div class="text-2xl flex-shrink-0 group-hover:scale-110 transition-transform duration-300">
                {highlight.icon}
              </div>
              <div class="min-w-0">
                <div class="font-semibold text-gray-900 text-sm sm:text-base">
                  {highlight.text}
                </div>
                <div class="text-xs sm:text-sm text-gray-600">
                  {highlight.subtext}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="lg:col-span-8 flex items-center min-h-[400px]">
        <!-- Guided story: progressive, skimmable, and accessible -->
        <div class="relative w-full">
          <div class="absolute inset-0 bg-gradient-to-r from-blue-50/50 to-purple-50/50 rounded-3xl blur-xl"></div>
          <div class="story-card relative bg-white rounded-3xl border border-gray-200/60 p-7 sm:p-9 md:p-11 shadow-2xl shadow-gray-500/10">
            <div class="relative z-10">
              <div class="flex items-center justify-between gap-4 mb-8">
                <p class="text-xs uppercase tracking-[0.2em] text-gray-500">About my work</p>
              </div>
              <div id="about-story" class="story-content space-y-7 text-lg sm:text-xl leading-relaxed text-gray-700 font-medium" aria-live="polite">
                {story.map((item, index) => (
                  <article class="story-step" data-step={index}>
                    <p class="story-text" data-text={item.text} data-emphasis={item.emphasis.join("|")}>{item.text}</p>
                  </article>
                ))}
              </div>
              <div class="mt-9 flex items-center gap-4">
                <div class="story-progress flex gap-2" aria-hidden="true">
                  {story.map((_, index) => <span class="story-dot" data-dot={index}></span>)}
                </div>
                <p id="story-status" class="text-sm text-gray-500">What I do and what I care about.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const storyRoot = document.querySelector('#about-story');
  if (storyRoot) {
    const steps = [...storyRoot.querySelectorAll('.story-step')];
    const dots = [...document.querySelectorAll('.story-dot')];
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let timer;
    let running = true;
    const finish = () => {
      clearTimeout(timer); running = false;
      steps.forEach((step) => step.classList.add('is-visible'));
      dots.forEach((dot) => dot.classList.add('is-active'));
    };
    const reveal = (stepIndex = 0, wordIndex = 0) => {
      if (!running || stepIndex >= steps.length) return finish();
      const text = steps[stepIndex].querySelector('.story-text');
      const allWords = words(text.dataset.text);
      const visible = allWords.slice(0, wordIndex + 1).join(' ');
      text.innerHTML = visible;
      (text.dataset.emphasis || '').split('|').filter(Boolean).forEach((phrase) => {
        text.innerHTML = text.innerHTML.replace(phrase, `<strong>${phrase}</strong>`);
      });
      steps[stepIndex].classList.add('is-visible'); dots[stepIndex].classList.add('is-active');
      if (wordIndex + 1 < allWords.length) timer = setTimeout(() => reveal(stepIndex, wordIndex + 1), reduceMotion ? 0 : 72);
      else timer = setTimeout(() => reveal(stepIndex + 1, 0), reduceMotion ? 0 : 700);
    };
    const observer = new IntersectionObserver((entries) => { if (entries.some((entry) => entry.isIntersecting)) { observer.disconnect(); if (reduceMotion) finish(); else reveal(); } }, { threshold: 0.25 });
    observer.observe(storyRoot);
  }
</script>

<style>
  .story-step { opacity: 1; transition: opacity 300ms ease; }
  .story-step.is-visible { opacity: 1; }
  .story-text strong { font-weight: 800; color: #111827; }
  .story-text span { animation: wordIn 260ms ease both; }
  .story-dot { width: 0.5rem; height: 0.5rem; border-radius: 999px; background: #d1d5db; transition: all 300ms ease; }
  .story-dot.is-active { width: 1.5rem; background: var(--accent-color, #1d4ed8); }
  @keyframes wordIn { from { opacity: 0; transform: translateY(3px); } to { opacity: 1; transform: translateY(0); } }
  @media (prefers-reduced-motion: reduce) { .story-step, .story-dot, .story-text span { transition: none; animation: none; } }
</style>
